# Supabase project configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PostgreSQL connection string for psycopg2 connection pool
# Supabase Transaction Pooler (port 6543) - REQUIRED for Render to avoid exhausting direct connection limits
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your_database_password_here@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Application security token for admin endpoints (/api/enroll, delete, etc.)
ADMIN_TOKEN=admin123
